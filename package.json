{
	"name": "reversible-effect",
	"title": "reversible effect",
	"version": "2.1.2",
	"description": "A collection of typed utility functions returning a callback to reverse their effect.",
	"main": "./dist/reversible-effect.js",
	"module": "./dist/reversible-effect.mjs",
	"types": "./dist/reversible-effect.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/reversible-effect.d.mts",
				"default": "./dist/reversible-effect.mjs"
			},
			"require": {
				"types": "./dist/reversible-effect.d.ts",
				"default": "./dist/reversible-effect.js"
			}
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=16"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"keywords": [
		"javascript",
		"typescript",
		"utilities",
		"utility",
		"effect",
		"addEventListener",
		"setTimeout",
		"setInterval",
		"requestAnimationFrame",
		"requestIdleCallback"
	],
	"scripts": {
		"start": "npm run dev",
		"build": "rollup -c",
		"dev": "npm run build -- --watch",
		"test": "vitest run",
		"test:runtime": "node test/runtime/require.cjs && node test/runtime/import.mjs",
		"test:package": "attw --pack .",
		"test:types": "vitest --typecheck --run",
		"test:env": "tsc -p test/environments/dom && tsc -p test/environments/node && tsc -p test/environments/bare && tsc -p test/environments/webworker",
		"test:toc": "markdown-toc-gen check README.md",
		"test:watch": "vitest",
		"lint": "eslint src/**/*.ts",
		"lint:fix": "npm run lint -- --fix",
		"prettier": "prettier --check ./src",
		"prettier:fix": "prettier --write ./src",
		"generate:event-maps": "node scripts/generate-event-maps.mjs",
		"generate:toc": "markdown-toc-gen insert README.md",
		"scripts:check-git": "git diff-index --quiet HEAD -- || (echo 'Error: Git repository is not clean. Please commit or stash changes.' && exit 1)",
		"release:patch": "npm version patch",
		"release:minor": "npm version minor",
		"release:major": "npm version major",
		"preversion": "npm run scripts:check-git && git pull",
		"postversion": "git push && git push --tags"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janpaepke/reversible-effect.git"
	},
	"author": {
		"name": "Jan Paepke",
		"url": "https://janpaepke.de"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/janpaepke/reversible-effect/issues"
	},
	"contributors": [],
	"homepage": "https://github.com/janpaepke/reversible-effect#readme",
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^24.13.4",
		"agadoo": "^3.0.0",
		"eslint": "^10.6.0",
		"expect-type": "^1.4.0",
		"globals": "^17.7.0",
		"jsdom": "^29.1.1",
		"markdown-toc-gen": "^1.2.0",
		"prettier": "^3.9.4",
		"rollup": "^4.62.2",
		"rollup-plugin-bundle-size": "^1.0.3",
		"rollup-plugin-delete": "^3.0.2",
		"rollup-plugin-dts": "^6.4.1",
		"rollup-plugin-license": "^3.7.1",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vitest": "^4.1.10"
	},
	"prettier": {
		"semi": true,
		"useTabs": true,
		"printWidth": 120,
		"bracketSpacing": true,
		"arrowParens": "avoid",
		"htmlWhitespaceSensitivity": "css",
		"endOfLine": "auto",
		"singleQuote": true,
		"trailingComma": "es5"
	}
}
